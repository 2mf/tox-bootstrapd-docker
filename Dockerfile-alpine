ARG TOX_VERISON
ARG ALPINE_VERSION

FROM alpine:$(ALPINE_VERSION) AS build

RUN apk add --no-cache \
    build-base \
    cmake \
    git \
    linux-headers \
    pkgconf \
    libsodium-dev \
    libsodium-static \
    libconfig-dev \
    libconfig-static \
    binutils \
    file

RUN mkdir -p /build \
  && cd /build \
  && git clone https://github.com/TokTok/c-toxcore --recursive -b $(TOX_VERSION) c-toxcore \
  && cd c-toxcore \
  && cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DENABLE_SHARED=OFF \
      -DENABLE_STATIC=ON \
      -DBOOTSTRAP_DAEMON=ON \
      -DBUILD_TOXAV=OFF \
      -DUNITTEST=OFF \
      -DCMAKE_EXE_LINKER_FLAGS="-static" \
  && cmake --build build --parallel \
  && cmake --install build --prefix /build/out \
  && test -x /build/out/bin/tox-bootstrapd

FROM alpine:$(ALPINE_VERSION)

RUN apk add bash py3-jinja2 py3-requests
RUN mkdir -p /opt/tox /var/lib/tox-bootstrapd /etc

COPY --from=build /build/out/bin/tox-bootstrapd /opt/tox/tox-bootstrapd
COPY --from=build /build/c-toxcore/other/bootstrap_daemon/tox-bootstrapd.conf /opt/tox/tox-bootstrapd.conf

ENV NODES_URL=https://nodes.tox.chat/json \
  PORT=33445 \
  KEYS_FILE_PATH='/var/lib/tox-bootstrapd/keys' \
  PID_FILE_PATH='/var/run/tox-bootstrapd/tox-bootstrapd.pid' \
  ENABLE_IPV6=true \
  ENABLE_IPV4_FALLBACK=true \
  ENABLE_LAN_DISCOVERY=false \
  ENABLE_TCP_RELAY=true \
  TCP_RELAY_PORTS="[3389,33445]" \
  ENABLE_MOTD=true \
  MOTD=tox-bootstrapd

ADD entrypoint.sh /entrypoint.sh
ADD tox-bootstrapd.conf.j2 /opt/tox/tox-bootstrapd.conf.j2
ADD render.py /opt/tox/render.py
RUN chmod +x /entrypoint.sh /opt/tox/render.py

EXPOSE 3389/tcp
EXPOSE 33445/tcp
EXPOSE 33445/udp

ENTRYPOINT ["/entrypoint.sh"]
