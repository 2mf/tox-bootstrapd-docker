ARG GOLANG_VERSION
ARG ALPINE_VERSION
ARG P2_VERSION
ARG TOX_VERSION

FROM golang:${GOLANG_VERSION}-alpine AS p2-build

RUN apk add --no-cache git

ARG P2_VERSION
ENV P2_VERSION=${P2_VERSION}
WORKDIR /src
RUN git clone https://github.com/wrouesnel/p2cli.git -b ${P2_VERSION} . \
  && go run mage.go binary \
  && test -x /src/p2

FROM alpine:${ALPINE_VERSION} AS build

RUN apk add --no-cache \
    build-base \
    cmake \
    git \
    linux-headers \
    pkgconf \
    libsodium-dev \
    libsodium-static \
    libconfig-dev \
    libconfig-static \
    binutils \
    file

ARG TOX_VERSION
RUN mkdir -p /build \
  && cd /build \
  && git clone https://github.com/TokTok/c-toxcore --recursive -b ${TOX_VERSION} c-toxcore \
  && cd c-toxcore \
  && cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DENABLE_SHARED=OFF \
      -DENABLE_STATIC=ON \
      -DBOOTSTRAP_DAEMON=ON \
      -DBUILD_TOXAV=OFF \
      -DUNITTEST=OFF \
      -DCMAKE_EXE_LINKER_FLAGS="-static" \
  && cmake --build build --parallel \
  && cmake --install build --prefix /build/out \
  && test -x /build/out/bin/tox-bootstrapd

FROM alpine:${ALPINE_VERSION}

RUN apk add --no-cache curl

RUN mkdir -p /var/lib/tox-bootstrapd

COPY --from=p2-build /src/p2 /usr/local/bin/p2
COPY --from=build /build/out/bin/tox-bootstrapd /usr/local/bin//tox-bootstrapd
COPY --from=build /build/c-toxcore/other/bootstrap_daemon/tox-bootstrapd.conf /etc/tox-bootstrapd.conf

ENV NODES_URL=https://nodes.tox.chat/json \
  PORT=33445 \
  KEYS_FILE_PATH='/var/lib/tox-bootstrapd/keys' \
  PID_FILE_PATH='/var/run/tox-bootstrapd/tox-bootstrapd.pid' \
  ENABLE_IPV6=true \
  ENABLE_IPV4_FALLBACK=true \
  ENABLE_LAN_DISCOVERY=false \
  ENABLE_TCP_RELAY=true \
  TCP_RELAY_PORTS="[3389,33445]" \
  ENABLE_MOTD=true \
  MOTD=tox-bootstrapd

ADD entrypoint.sh /entrypoint.sh
ADD tox-bootstrapd.conf.j2 /opt/tox/tox-bootstrapd.conf.j2

EXPOSE 3389/tcp
EXPOSE 33445/tcp
EXPOSE 33445/udp

ENTRYPOINT ["/entrypoint.sh"]
