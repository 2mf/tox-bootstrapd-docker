# Alpine base image used by Dockerfile-alpine.
ALPINE_VERSION=3.23

# Debian base image used by Dockerfile-debian.
DEBIAN_VERSION=trixie-slim

# Used by builds triggered by commits.
TOX_VERSION=v0.2.23

# Used by builds for template renderer.
GOLANG_VERSION=1.25
P2_VERSION=r19

# to get json content from https://nodes.tox.chat/json
CURL_VERSION=8.22.0
